@startuml robot-activity
title Робот-тележка — UML-диаграмма деятельности

skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam activityBackgroundColor #F2F6FA
skinparam activityBorderColor #40556B
skinparam ArrowColor #40556B

start
partition "Подготовка" {
    :Подключить камеру и контроллер;
    :Ожидать готовности оборудования\nс ограничением времени;
    if (Готовность подтверждена?) then (да)
        :Ожидать непустой маршрут\nи команду Пуск от оператора;
        :Выбрать первую точку;
    else (нет)
        :Запросить остановку; перейти в Fault;\nСообщить об ошибке или тайм-ауте;
        stop
    endif
}

partition "Выполнение маршрута" {
    while (Есть непройденные точки\nи нет команды остановки?) is (да)
        :Получить телеметрию контроллера;
        if (Датчики и связь исправны?) then (да)
            :Получить новый кадр камеры;
            :Распознать метки и перевести\nкоординаты в систему пола;
            if (Целевая метка найдена?) then (да)
                :Сопоставить цель и положение\nробота по одометрии;
                if (Точка достигнута?) then (да)
                    :Отметить точку пройденной;\nВыбрать следующую, если она есть;
                else (нет)
                    :Рассчитать линейную\nи угловую скорость;
                    :Передать команду контроллеру\nдля управления приводами;
                endif
            else (нет)
                :Передать нулевую скорость;\nСохранить текущую цель;
            endif
        else (нет)
            :Запросить остановку; перейти в Fault;\nСообщить об аварии;
            stop
        endif
        :Дождаться следующего периода управления;
    endwhile (нет)
}

partition "Завершение" {
    :Запомнить причину остановки:\nмаршрут завершён или команда оператора;
    :Отправить Стоп; перейти в Stopping;
    :Ожидать подтверждения нулевой скорости\nс ограничением времени;
    if (Остановка подтверждена?) then (да)
        if (Причина — завершение маршрута?) then (да)
            :Перейти в Completed;\nСообщить оператору Готово;
        else (нет)
            :Перейти в Stopped;\nСообщить об остановке оператором;
        endif
    else (нет)
        :Повторить запрос остановки;\nПерейти в Fault; сообщить о тайм-ауте;
    endif
}
stop

legend bottom
    Логика по циклограмме реализована в Robot; оборудование имитируется.
    Аварии и ошибки любого этапа вызывают запрос Стоп и переход в Fault.
    Контроллер независимо блокирует приводы по аварийным входам и watchdog.
    При потере связи команда Стоп не считается подтверждением остановки.
endlegend
@enduml
